{
  "build": {
    "appId": "space.lyric.tool",
    "directories": {
      "output": "dist"
    },
    "dmg": {
      "window": {
        "height": 380,
        "width": 540
      },
      "backgroundColor": "#ffffff"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/app.icns"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "转歌词"
    },
    "productName": "转歌词",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/app.ico"
    }
  },
  "description": "转歌词工具桌面版：歌谱识别、智能清理、拆页、多语对照、拼音、导出 ProPresenter 文本（除翻译外全部离线可用）",
  "main": "main.js",
  "name": "lyric-tool",
  "productName": "转歌词",
  "scripts": {
    "dist": "electron-builder",
    "start": "electron ."
  },
  "version": "1.0.0",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "icon-gen": "^5.0.0"
  }
}